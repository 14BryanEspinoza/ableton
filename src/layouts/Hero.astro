---
import { Image } from "astro:assets";
import Link from "@components/Link.astro";
import wallpaper from "../assets/wallpaper.png";
---

<section class="relative mb-4" aria-labelledby="home-title">
  <div class="mt-2 flex gap-6 px-4 py-2 text-sm lg:px-16 lg:pt-4">
    <Link
      url="#acerca-de"
      label="Acerca de"
      className="text-primary font-bold"
    />
    <Link url="#empleos" label="Empleos" />
  </div>

  <h1
    id="home-title"
    class="absolute top-2/4 left-2/4 -translate-2/4 text-center text-3xl font-bold text-yellow-200 md:text-4xl lg:text-5xl"
  >
    Ableton
  </h1>

  <figure class="mx-auto flex max-w-6xl justify-center">
    <Image
      src={wallpaper}
      alt="Imagen principal de Ableton"
      priority
      class="h-full w-full object-cover"
    />
  </figure>
</section>
