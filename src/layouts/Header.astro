---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Link from "@components/Link.astro";
import Button from "@components/Button.astro";
import { linkNavbar } from "@data/links";
import favicon from "@assets/favicon.png";
---

<header
  class="sticky top-0 z-10 flex flex-wrap items-center justify-between bg-bg p-4 shadow md:px-8"
>
  <figure class="size-8">
    <a href="/">
      <Image src={favicon} alt="Logo de la pagina" loading="eager" />
    </a>
  </figure>

  <input type="checkbox" id="menu-toggle" class="peer hidden" />
  <label for="menu-toggle" aria-label="Open menu">
    <Icon name="lucide:menu" class="cursor-pointer text-3xl lg:hidden" />
  </label>

  <nav
    class="hidden h-[90dvh] w-full flex-col items-center justify-center gap-8 text-center peer-checked:flex lg:flex lg:h-auto lg:w-[95%] lg:flex-row lg:justify-between"
    aria-label="Principal"
  >
    <ul role="list" class="lg:flex lg:items-center lg:gap-4">
      {
        linkNavbar.map((link) => (
          <li>
            <Link
              url={link.url}
              label={link.label}
              className="mt-4 block lg:mt-0"
            />
          </li>
        ))
      }
    </ul>

    <ul role="list" class="lg:flex lg:items-center lg:gap-4">
      <li>
        <Link url="#" label="Get Started" />
      </li>
      <li>
        <Button label="Account" className="mt-4 lg:mt-0" />
      </li>
      <li>
        <Button label="Log out" className="mt-4 lg:mt-0" />
      </li>
    </ul>
  </nav>
</header>
