---
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";
import Link from "@components/Link.astro";
import Button from "@components/Button.astro";
import { linkNavbar } from "@data/links";
import favicon from "@assets/favicon.png";
---

<header
  class="sticky top-0 z-10 mb-4 flex flex-wrap items-center justify-between bg-bg p-4 shadow md:px-8"
>
  <figure class="size-8">
    <a href="/ableton/">
      <Picture src={favicon} alt="Logo de la página" loading="eager" />
    </a>
  </figure>

  <input type="checkbox" id="menu-toggle" class="peer sr-only" />
  <label
    for="menu-toggle"
    class="rounded-md p-1 peer-focus-visible:ring-2 peer-focus-visible:ring-primary peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-bg lg:hidden"
    aria-label="Abrir menú"
  >
    <Icon name="lucide:menu" class="cursor-pointer text-3xl" />
  </label>

  <nav
    class="hidden h-[90dvh] w-full flex-col items-center justify-center gap-8 text-center peer-checked:flex lg:flex lg:h-auto lg:w-[95%] lg:flex-row lg:justify-between"
    aria-label="Principal"
  >
    <ul role="list" class="lg:flex lg:items-center lg:gap-4">
      {
        linkNavbar.map((link) => (
          <li>
            <Link
              url={link.url}
              label={link.label}
              className="mt-4 block lg:mt-0"
            />
          </li>
        ))
      }
    </ul>

    <ul role="list" class="lg:flex lg:items-center lg:gap-4">
      <li>
        <Link url="#" label="Empezar" />
      </li>
      <li>
        <Button label="Cuenta" className="mt-4 lg:mt-0" />
      </li>
      <li>
        <Button label="Cerrar sesión" className="mt-4 lg:mt-0" />
      </li>
    </ul>
  </nav>
</header>
