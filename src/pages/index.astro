---
import Layout from "@layouts/Layout.astro";
import Hero from "@layouts/Hero.astro";
import Section from "@components/Section.astro";
import {
  create,
  cleanCode,
  panel,
  pasion,
  team,
  creativity,
} from "@data/collection";
import Footer from "@layouts/Footer.astro";
---

<Layout>
  <main id="main-content">
    <Hero />
    <Section {...create} />
    <Section {...cleanCode} />
    <Section {...team} />
    <Section {...creativity} />
    <Section {...pasion} />
    <Section {...panel} />
  </main>
  <Footer />
</Layout>
