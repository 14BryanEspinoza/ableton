---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import Header from "@layouts/Header.astro";
import Footer from "@layouts/Footer.astro";
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="flex min-h-[calc(100vh-160px)] items-center justify-center bg-bg p-4 md:p-8"
  >
    <div
      class="group flex w-full max-w-2xl flex-col items-center rounded-xl border border-border bg-bg-secondary p-8 text-center shadow-xs sm:p-14"
    >
      <div class="relative my-6 flex w-full items-center justify-center py-6">
        <div
          class="absolute h-16 w-36 -translate-x-8 -translate-y-4 -rotate-6 rounded-xs bg-accent opacity-90 transition-transform duration-300 ease-out group-hover:-translate-x-10 group-hover:-translate-y-6 group-hover:-rotate-12 sm:h-24 sm:w-56"
          aria-hidden="true"
        >
        </div>

        <div
          class="absolute h-16 w-32 translate-x-10 translate-y-3 rotate-6 rounded-xs bg-yellow opacity-90 transition-transform duration-300 ease-out group-hover:translate-x-12 group-hover:translate-y-5 group-hover:rotate-12 sm:h-24 sm:w-48"
          aria-hidden="true"
        >
        </div>

        <div
          class="absolute h-16 w-28 -translate-x-2 translate-y-5 -rotate-3 rounded-xs bg-blue-light opacity-90 transition-transform duration-300 ease-out group-hover:-translate-x-4 group-hover:translate-y-7 group-hover:-rotate-6 sm:h-24 sm:w-40"
          aria-hidden="true"
        >
        </div>
        <h1
          class="relative z-10 text-7xl font-black tracking-tight text-text sm:text-9xl"
        >
          404
        </h1>
      </div>

      <div class="relative z-10 max-w-md">
        <h2
          class="mb-3 text-2xl font-bold tracking-tight text-text sm:text-3xl"
        >
          Página no encontrada
        </h2>

        <p class="mb-8 text-base leading-relaxed text-text-secondary">
          Lo sentimos, la página que buscas no existe, ha sido eliminada o
          cambió de dirección.
        </p>

        <a
          href="/ableton/"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-6 py-3 text-sm font-semibold text-bg shadow-md transition-all hover:scale-105 active:bg-accent"
        >
          <Icon name="lucide:home" class="size-5" />
          Volver al Inicio
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
