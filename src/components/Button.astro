---
interface Props {
  label: string;
  className?: string;
}

const { label, className } = Astro.props as Props;
const base =
  "cursor-pointer text-sm border border-border px-6 py-1 rounded-md transition-all hover:scale-105 hover:bg-primary hover:text-bg active:bg-accent";
---

<button class={`${base} ${className}`}>{label}</button>
