---
interface Props {
  label: string;
  className?: string;
  type?: "button" | "submit" | "reset";
}

const baseStyle =
  "cursor-pointer px-6 py-2 rounded-md text-text text-sm border border-border transition hover:font-bold hover:scale-105 hover:text-bg hover:bg-primary active:text-text active:bg-blue-light";

const { label, className = "", type = "button" } = Astro.props;
---

<button class={`${baseStyle} ${className}`} type={type}>{label}</button>
