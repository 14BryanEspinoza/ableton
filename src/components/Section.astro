---
import { Picture } from "astro:assets";
import type { CollectionProps } from "@data/collection.ts";
import Link from "./Link.astro";

const { title, description, image, labelledby, panelText, panelLink } =
  Astro.props as CollectionProps;
---

<section class="px-6 pt-20 md:px-12" aria-labelledby=`${labelledby}-title`>
  <div class="lg:mx-auto lg:max-w-4xl">
    <h2 id=`${labelledby}-title` class="mb-8 font-bold">
      {title}
    </h2>

    <p class="mb-16 text-justify">
      {description}
    </p>
  </div>

  <div
    class={`flex flex-col items-center max-w-2xs mx-auto mb-8 rounded-md md:max-w-2xl md:flex-row`}
  >
    {
      image.map((img) => (
        <figure
          class:list={[
            "mx-auto max-w-2xs",
            { "hidden lg:block": img.hideMobile },
          ]}
        >
          <Picture
            src={img.url}
            alt={img.alt}
            formats={["avif", "webp"]}
            layout="constrained"
            loading="lazy"
            decoding="async"
            class="rounded-md"
          />

          {img.figCaption && (
            <figcaption class="mt-8 text-center">{img.figCaption}</figcaption>
          )}
        </figure>
      ))
    }

    {
      panelText && panelLink && (
        <div class="rounded-b-md p-4 shadow-md md:p-8">
          <h3 class="mb-4 text-justify text-sm font-bold">{panelText}</h3>

          {panelLink.map((link) => (
            <Link {...link} />
          ))}
        </div>
      )
    }
  </div>
</section>
