---
interface Props {
  url: string;
  label: string;
  className?: string;
  skip?: boolean;
}

const baseStyle =
  "inline-block text-sm text-text transition hover:text-primary hover:font-bold hover:underline hover:scale-105";
const skipStyle =
  "sr-only text-text transition focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-6 focus:py-2 focus:rounded-md focus:font-bold focus:bg-blue-light";

const { url, label, className = "", skip = false } = Astro.props;
---

<a href={url} class={`${skip ? skipStyle : baseStyle} ${className}`}>{label}</a>
