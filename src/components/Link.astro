---
interface Props {
  url: string;
  label: string;
  className?: string;
  skip?: boolean;
}

const { url, label, className, skip = false } = Astro.props as Props;
const base =
  "text-sm hover:scale-105 hover:underline hover:text-primary transition-all";
const skipClass =
  "inline text-bg bg-primary absolute top-0 left-4 z-50 -translate-y-12 rounded-md px-6 py-1 transition-all focus:translate-y-4";
---

<a href={url} class={`${skip ? skipClass : base} ${className}`}>{label}</a>
