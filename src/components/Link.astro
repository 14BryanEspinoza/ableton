---
interface Props {
  url: string;
  label: string;
  skip?: boolean;
}

const { url, label, skip = false } = Astro.props;
---

<a href={url} class={`${skip ? "skip-link" : "static-link"}`}>{label}</a>

<style>
  .skip-link {
    position: absolute;
    top: 0;
    left: 25%;
    z-index: 100;
    padding: 0.5rem 1.5rem;
    border-radius: 0.5rem;
    color: var(--color-bg);
    background: var(--color-primary);
    transform: translateY(-100%);
    transition: all 0.3s ease-in;

    &:focus {
      transform: translateY(50%);
    }
  }

  :focus-visible {
    outline-offset: 2px;
    outline: 2px solid var(--color-primary);
  }
</style>
